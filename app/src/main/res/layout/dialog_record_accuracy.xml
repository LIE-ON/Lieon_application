<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="30dp"
    android:elevation="8dp"
    android:layout_margin="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="목표값을 설정하세요"
        android:textColor="#333333"
        android:textSize="24sp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/accuracy_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:paddingLeft="20dp"
            android:text="목표정확도 : "
            android:textColor="#555555"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/accuracy_seekbar_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90%"
            android:textColor="#555555"
            android:textSize="20sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/accuracy_seekbar"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:max="100"
        android:progress="90"
        android:thumbTint="@color/purple_1"
        android:progressTint="@color/purple_1"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/accuracy_submit_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_button_background"
        android:text="제출하기"
        android:textColor="@android:color/white"
        android:padding="10dp" />

</LinearLayout>
